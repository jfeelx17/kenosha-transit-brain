# Copy to .env.local and edit. Everything here is optional.

# Upstream real-time API (GMV Syncromatics "Track" white-label site).
TRANSIT_BASE_URL=https://www.kenoshatransit.com
# How to talk to the site. auto = try the modern portal proxy (kenoshatransit.com/api/rtpi?path=...) first,
# then the classic Syncromatics Track endpoints (/Region/0/Routes). Force with portal or track.
TRANSIT_API_STYLE=auto
# Proxy path used by the modern site for its data calls.
TRANSIT_RTPI_PATH=/api/rtpi
# Classic Track only: region whose routes to list; other regions are discovered from /Regions.
TRANSIT_REGION_ID=0
# Some Syncromatics deployments want ?customerId=... on /Stop/{id}/Arrivals. Leave empty unless arrivals come back empty.
TRANSIT_CUSTOMER_ID=
# Per-request timeout to the upstream API, in milliseconds.
TRANSIT_TIMEOUT_MS=10000

# Serve built-in fake routes/buses/arrivals instead of hitting the real API.
# Handy at night when no buses run, or when offline. Set to 1 to enable.
KENOSHA_MOCK=

# Basemap. One of:
#   openfreemap-dark  (default: free vector dark OSM style, no API key)
#   carto-dark        (free raster dark OSM tiles from CARTO)
#   osm-dark          (raw openstreetmap.org tiles, dimmed with a raster filter)
#   inline            (no tiles, plain dark background; offline/testing)
#   or any full style URL, e.g. https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE=openfreemap-dark

# Polling intervals (milliseconds).
NEXT_PUBLIC_POLL_VEHICLES_MS=10000
NEXT_PUBLIC_POLL_ARRIVALS_MS=15000
